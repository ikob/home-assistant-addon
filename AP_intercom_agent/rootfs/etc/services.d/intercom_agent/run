#!/usr/bin/with-contenv bashio
# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: Copyright (c) 2026, Katsushi Kobayashi
set -euo pipefail

LAUNCHER_REVISION="capture-images-v1"

USERNAME="$(bashio::config 'username')"
PASSWORD="$(bashio::config 'password')"
PROXY="$(bashio::config 'proxy')"
REGISTER_URI="$(bashio::config 'register_uri')"
MESSAGE_URI="$(bashio::config 'message_uri')"
ENTRANCE_URI="$(bashio::config 'entrance_uri')"
JPEG_QUERY_S="$(bashio::config 'jpeg_query_s')"
INCOMING_JPEG_MAX_FILES="$(bashio::config 'incoming_jpeg_max_files')"
INCOMING_JPEG_DIR="/media/ap_intercom_agent"

ANSWER_CALLS="$(bashio::config 'answer_calls')"
CAPTURE_IMAGES="$(bashio::config 'capture_images')"
SEND_MESSAGES="$(bashio::config 'send_messages')"
DEBUG="$(bashio::config 'debug')"

EXPIRY="600s"
RETRY="30s"

LOG_LEVEL="info"
if bashio::config.true 'debug'; then
  LOG_LEVEL="debug"
fi

declare -a ALLOWED_CALLERS=()
declare -a UNLOCK_CALLERS=()

append_allowed_caller() {
  local caller="$1"
  [[ -n "${caller}" ]] || return 0
  local existing
  if (( ${#ALLOWED_CALLERS[@]} > 0 )); then
    for existing in "${ALLOWED_CALLERS[@]}"; do
      [[ "${existing}" != "${caller}" ]] || return 0
    done
  fi
  ALLOWED_CALLERS+=("${caller}")
}

append_unlock_caller() {
  local caller="$1"
  [[ -n "${caller}" ]] || return 0
  local existing
  if (( ${#UNLOCK_CALLERS[@]} > 0 )); then
    for existing in "${UNLOCK_CALLERS[@]}"; do
      [[ "${existing}" != "${caller}" ]] || return 0
    done
  fi
  UNLOCK_CALLERS+=("${caller}")
}

OPTIONS_PATH="${OPTIONS_PATH:-/data/options.json}"
if [[ ! -r "${OPTIONS_PATH}" ]]; then
  bashio::log.error "Cannot read add-on options: ${OPTIONS_PATH}"
  exit 1
fi

ALLOWED_CALLERS_OPTION_TYPE="$(jq --raw-output '(.allowed_callers // []) | type' "${OPTIONS_PATH}")"
UNLOCK_CALLERS_OPTION_TYPE="$(jq --raw-output '(.unlock_callers // []) | type' "${OPTIONS_PATH}")"
if [[ "${ALLOWED_CALLERS_OPTION_TYPE}" != "array" || "${UNLOCK_CALLERS_OPTION_TYPE}" != "array" ]]; then
  bashio::log.error "allowed_callers and unlock_callers must be arrays"
  exit 1
fi

CONFIG_ALLOWED_CALLER_COUNT="$(jq --raw-output '(.allowed_callers // []) | length' "${OPTIONS_PATH}")"
CONFIG_UNLOCK_CALLER_COUNT="$(jq --raw-output '(.unlock_callers // []) | length' "${OPTIONS_PATH}")"

# Read arrays from one options JSON snapshot. Bashio 0.17.5 builds the
# bashio::config query with `read -d ''`; under `set -e`, calling it from a
# process substitution can exit before emitting the array. Reading the official
# /data/options.json file with jq avoids that path entirely.
while IFS= read -r caller; do
  append_allowed_caller "${caller}"
done < <(jq --raw-output '(.allowed_callers // [])[]? | select(type == "string" and length > 0)' "${OPTIONS_PATH}")

# Keep installations upgraded from 0.1.x working. A saved legacy caller stays
# allowed until the user clears it, but it is never added to unlock_callers.
LEGACY_ALLOWED_CALLER="$(jq --raw-output '(.allowed_caller // "") | select(type == "string")' "${OPTIONS_PATH}")"
LEGACY_ALLOWED_CALLER_PRESENT="false"
if [[ -n "${LEGACY_ALLOWED_CALLER}" ]]; then
  append_allowed_caller "${LEGACY_ALLOWED_CALLER}"
  LEGACY_ALLOWED_CALLER_PRESENT="true"
fi

if (( ${#ALLOWED_CALLERS[@]} == 0 )); then
  bashio::log.error "At least one non-empty allowed_callers entry is required"
  exit 1
fi

while IFS= read -r caller; do
  append_unlock_caller "${caller}"
done < <(jq --raw-output '(.unlock_callers // [])[]? | select(type == "string" and length > 0)' "${OPTIONS_PATH}")

mkdir -p "${INCOMING_JPEG_DIR}"

ARGS=(
  -expiry "${EXPIRY}"
  -retry "${RETRY}"
  -username "${USERNAME}"
  -password "${PASSWORD}"
  -proxy "${PROXY}"
  -register-uri "${REGISTER_URI}"
  -message-uri "${MESSAGE_URI}"
  -entrance-uri "${ENTRANCE_URI}"
  -answer-calls="${ANSWER_CALLS}"
  -capture-images="${CAPTURE_IMAGES}"
  -send-messages="${SEND_MESSAGES}"
  -reject-code 486
  -reject-reason "Busy Here"
  -log-level="${LOG_LEVEL}"
  -jpeg-query-s "${JPEG_QUERY_S}"
  -incoming-jpeg-dir "${INCOMING_JPEG_DIR}"
  -incoming-jpeg-max-files "${INCOMING_JPEG_MAX_FILES}"
  -unlock-caller=
)

if (( ${#ALLOWED_CALLERS[@]} > 0 )); then
  for caller in "${ALLOWED_CALLERS[@]}"; do
    ARGS+=(-allowed-caller "${caller}")
  done
  ALLOWED_CALLERS_LOG="$(IFS=,; echo "${ALLOWED_CALLERS[*]}")"
else
  ALLOWED_CALLERS_LOG="(none)"
fi

if (( ${#UNLOCK_CALLERS[@]} > 0 )); then
  for caller in "${UNLOCK_CALLERS[@]}"; do
    ARGS+=(-unlock-caller "${caller}")
  done
  UNLOCK_CALLERS_LOG="$(IFS=,; echo "${UNLOCK_CALLERS[*]}")"
else
  UNLOCK_CALLERS_LOG="(none)"
fi

bashio::log.info "Starting intercom_agent (addon_version=${ADDON_VERSION:-unknown}, launcher=${LAUNCHER_REVISION}, user=${USERNAME}, proxy=${PROXY}, config_allowed_count=${CONFIG_ALLOWED_CALLER_COUNT}, config_unlock_count=${CONFIG_UNLOCK_CALLER_COUNT}, legacy_allowed=${LEGACY_ALLOWED_CALLER_PRESENT}, allowed=${ALLOWED_CALLERS_LOG}, unlock=${UNLOCK_CALLERS_LOG}, answer_calls=${ANSWER_CALLS}, capture_images=${CAPTURE_IMAGES}, send_messages=${SEND_MESSAGES}, jpeg_dir=${INCOMING_JPEG_DIR}, jpeg_max_files=${INCOMING_JPEG_MAX_FILES}, log_level=${LOG_LEVEL}, expiry=${EXPIRY}, retry=${RETRY})"

exec /usr/local/bin/intercom_agent "${ARGS[@]}"
